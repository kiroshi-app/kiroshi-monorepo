{
	"name": "app",
	"version": "0.26.0",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kiroshi-app/kiroshi-monorepo.git"
	},
	"type": "module",
	"scripts": {
		"dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"dev:web": "vite",
		"build": "tsc -b && vite build",
		"serve": "vite preview",
		"types": "tsc -b",
		"test": "vitest run && ../../scripts/slot.sh cargo test --manifest-path src-tauri/Cargo.toml --features fake-claude",
		"test:unit": "vitest run",
		"test:live": "cargo test --manifest-path src-tauri/Cargo.toml --features fake-claude --test real_claude -- --ignored --test-threads=1",
		"lint": "biome lint",
		"lint:fix": "biome check --assist-enabled=true --unsafe --write .",
		"tauri:build": "tauri build"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.104.2",
		"@tanstack/react-query-devtools": "^5.104.2",
		"@tanstack/react-router": "^1.170.42",
		"@tauri-apps/api": "^2.12.2",
		"@tauri-apps/plugin-dialog": "^2.8.1",
		"@tauri-apps/plugin-opener": "^2.7.0",
		"@tauri-apps/plugin-os": "^2.4.0",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@workspace/ui": "workspace:*",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4",
		"@tauri-apps/cli": "^2.12.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"agentation": "~3.1.2",
		"happy-dom": "^20.14.6",
		"vite": "catalog:",
		"vitest": "5.0.3"
	}
}
