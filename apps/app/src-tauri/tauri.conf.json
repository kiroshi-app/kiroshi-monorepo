{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Kiroshi",
	"version": "0.25.0-beta.2",
	"identifier": "com.kiroshi.app",
	"build": {
		"beforeDevCommand": "bun run dev:web",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self' 'unsafe-inline'",
				"img-src": "'self' asset: http://asset.localhost data: blob: https: http://127.0.0.1:*",
				"font-src": "'self' data:",
				"connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
				"object-src": "'none'",
				"base-uri": "'self'",
				"frame-src": "'none'"
			},
			"dangerousDisableAssetCspModification": ["style-src"],
			"assetProtocol": {
				"enable": true,
				"scope": ["$APPDATA/avatars/*", "$APPDATA/attachments/**"]
			}
		},
		"windows": [
			{
				"label": "main",
				"create": false,
				"title": "Kiroshi",
				"dragDropEnabled": false,
				"visible": false,
				"width": 1280,
				"height": 832,
				"minWidth": 1024,
				"minHeight": 680,
				"center": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true
			}
		]
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["kiroshi"]
			}
		},
		"updater": {
			"endpoints": [
				"https://github.com/kiroshi-app/kiroshi-monorepo/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMkVBNjdDQ0I1QTc2N0QKUldSOWRsckxmS1l1ajArcW54RTM3R0dWSEJ1YTBMbnhlYjdnakg3MXA4RTFUajlvUFVDT0lJdzMK"
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"externalBin": ["binaries/kiroshi-agent", "binaries/kiroshi-claude"],
		"targets": ["app", "dmg", "deb", "nsis"],
		"category": "DeveloperTool",
		"copyright": "© 2026 Kiroshi",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"minimumSystemVersion": "10.15",
			"entitlements": "entitlements.plist"
		}
	}
}
