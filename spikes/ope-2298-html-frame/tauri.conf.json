{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "ope-2298-html-frame",
	"version": "0.0.0",
	"identifier": "com.kiroshi.spike.ope2298",
	"build": {
		"frontendDist": "./ui"
	},
	"app": {
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self' 'unsafe-inline'",
				"img-src": "'self' asset: http://asset.localhost data: blob: https: http://127.0.0.1:*",
				"font-src": "'self' data:",
				"connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
				"object-src": "'none'",
				"base-uri": "'self'",
				"frame-src": "'none'"
			},
			"dangerousDisableAssetCspModification": ["style-src"]
		},
		"windows": []
	},
	"bundle": {
		"active": false,
		"icon": [
			"../../apps/app/src-tauri/icons/icon.png",
			"../../apps/app/src-tauri/icons/icon.ico"
		]
	}
}
