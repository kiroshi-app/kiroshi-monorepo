{
	"permissions": {
		"allow": [
			"Bash(gh pr merge --auto *)",
			"Bash(git push --force-with-lease origin feature/*)",
			"Bash(git push origin feature/*)",
			"Bash(git push -u origin feature/*)",
			"Bash(scripts/pr-dequeue.sh)",
			"Bash(./scripts/pr-dequeue.sh)"
		],
		"ask": [
			"Bash(git push* +*)",
			"Bash(git push* --force)",
			"Bash(git push* --force *)",
			"Bash(git push* -f*)",
			"Bash(git push* -nf*)",
			"Bash(git push* -qf*)",
			"Bash(git push* -uf*)",
			"Bash(git push* -vf*)"
		],
		"deny": [
			"Edit(/scripts/pr-dequeue.sh)",
			"Write(/scripts/pr-dequeue.sh)",
			"Bash(gh pr merge* --squash*)",
			"Bash(gh pr merge* --merge*)",
			"Bash(gh pr merge* --rebase*)",
			"Bash(gh pr merge* --admin*)",
			"Bash(gh pr merge* -s)",
			"Bash(gh pr merge* -s *)",
			"Bash(gh pr merge* -m)",
			"Bash(gh pr merge* -m *)",
			"Bash(gh pr merge* -r)",
			"Bash(gh pr merge* -r *)",
			"Bash(gh pr merge* -s*)",
			"Bash(gh pr merge* -m*)",
			"Bash(gh pr merge* -r*)",
			"Bash(gh pr merge* -d*s*)",
			"Bash(gh pr merge* -d*m*)",
			"Bash(gh pr merge* -d*r*)",
			"Bash(git push* origin main)",
			"Bash(git push* origin main *)",
			"Bash(git push* +main)",
			"Bash(git push* +main *)",
			"Bash(git push*:main)",
			"Bash(git push*:main *)",
			"Bash(git push*refs/heads/main)",
			"Bash(git push*refs/heads/main *)"
		]
	}
}
