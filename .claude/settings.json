{
	"permissions": {
		"allow": [
			"Bash(git push --force-with-lease origin feature/*)",
			"Bash(git push origin feature/*)",
			"Bash(git push -u origin feature/*)"
		],
		"deny": [
			"Bash(git push* main)",
			"Bash(git push* main *)",
			"Bash(git push* +main)",
			"Bash(git push* +main *)",
			"Bash(git push*:main)",
			"Bash(git push*:main *)",
			"Bash(git push*refs/heads/main)",
			"Bash(git push*refs/heads/main *)"
		]
	}
}
