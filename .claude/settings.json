{
	"permissions": {
		"allow": [
			"Bash(git push --force-with-lease origin feature/*)",
			"Bash(git push origin feature/*)",
			"Bash(git push -u origin feature/*)"
		],
		"ask": [
			"Bash(git push* +*)",
			"Bash(git push* --force)",
			"Bash(git push* --force *)",
			"Bash(git push* -f*)",
			"Bash(git push* -nf*)",
			"Bash(git push* -qf*)",
			"Bash(git push* -uf*)",
			"Bash(git push* -vf*)"
		],
		"deny": [
			"Bash(git push* main)",
			"Bash(git push* main *)",
			"Bash(git push* +main)",
			"Bash(git push* +main *)",
			"Bash(git push*:main)",
			"Bash(git push*:main *)",
			"Bash(git push*refs/heads/main)",
			"Bash(git push*refs/heads/main *)"
		]
	}
}
