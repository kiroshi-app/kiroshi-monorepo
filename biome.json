{
	"root": true,
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/src/generated",
			"!apps/app/contracts",
			"!apps/app/src/lib/bindings.ts",
			"!apps/ios/Kiroshi/Resources",
			"!packages/ui/src/components/companion-avatar.fixture.jsonl",
			"!docs/relay/member-socket.schema.json",
			"!packages/ui/src/components/ui"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"includes": ["**", "!**/*.grit", "!packages/ui/src/styles/typeset.css"]
	},
	"plugins": [
		{
			"path": "./biome-plugins/no-hardcoded-text.grit",
			"includes": [
				"**/src/**/*.tsx",
				"!**/*.stories.tsx",
				"!**/src/foundations/**"
			]
		}
	],
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": {
					"level": "warn",
					"fix": "none"
				},
				"noDefaultExport": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@keyline-icons/react": "Import icons via Icons from \"@workspace/ui/components/icons\" (e.g. Icons.Home). Keyline (@keyline-icons/react) is the only icon library in this repo, centralized in packages/ui/src/components/icons.tsx.",
							"lucide-react": "Import icons via Icons from \"@workspace/ui/components/icons\" (e.g. Icons.Home). Keyline (@keyline-icons/react) is the only icon library in this repo, centralized in packages/ui/src/components/icons.tsx.",
							"@hugeicons/react": "Import icons via Icons from \"@workspace/ui/components/icons\" (e.g. Icons.Home). Keyline (@keyline-icons/react) is the only icon library in this repo, centralized in packages/ui/src/components/icons.tsx.",
							"@hugeicons/core-free-icons": "Import icons via Icons from \"@workspace/ui/components/icons\" (e.g. Icons.Home). Keyline (@keyline-icons/react) is the only icon library in this repo, centralized in packages/ui/src/components/icons.tsx.",
							"react-icons": "Import icons via Icons from \"@workspace/ui/components/icons\" (e.g. Icons.Home). Keyline (@keyline-icons/react) is the only icon library in this repo, centralized in packages/ui/src/components/icons.tsx.",
							"@heroicons/react": "Import icons via Icons from \"@workspace/ui/components/icons\" (e.g. Icons.Home). Keyline (@keyline-icons/react) is the only icon library in this repo, centralized in packages/ui/src/components/icons.tsx.",
							"@radix-ui/react-icons": "Import icons via Icons from \"@workspace/ui/components/icons\" (e.g. Icons.Home). Keyline (@keyline-icons/react) is the only icon library in this repo, centralized in packages/ui/src/components/icons.tsx."
						}
					}
				},
				"useConsistentArrayType": "error",
				"useConsistentObjectDefinitions": "error",
				"useConsistentCurlyBraces": {
					"level": "error",
					"fix": "safe"
				}
			},
			"complexity": {
				"useArrowFunction": "error",
				"noExcessiveCognitiveComplexity": "warn"
			},
			"correctness": {
				"noUnusedImports": {
					"level": "error",
					"fix": "safe"
				}
			},
			"suspicious": {
				"noExplicitAny": "error"
			},
			"security": {
				"noDangerouslySetInnerHtml": "warn"
			},
			"a11y": {
				"useKeyWithClickEvents": "off",
				"useFocusableInteractive": "warn",
				"useSemanticElements": "warn"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							":URL:",
							":BLANK_LINE:",
							[":BUN:", ":NODE:"],
							":BLANK_LINE:",
							[":PACKAGE:", "!@workspace", "!@workspace/**"],
							":BLANK_LINE:",
							["@workspace", "@workspace/**"],
							":BLANK_LINE:",
							["./*"],
							":BLANK_LINE:",
							["../*"]
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		}
	},
	"css": {
		"parser": {
			"cssModules": false,
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["apps/app/src-tauri/plugins/kiroshi/applications/logos/**"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/ui/src/components/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": "off"
					},
					"correctness": {
						"useHookAtTopLevel": "off"
					},
					"a11y": {
						"useSemanticElements": "off",
						"useFocusableInteractive": "off"
					},
					"performance": {
						"noAccumulatingSpread": "off"
					},
					"security": {
						"noDangerouslySetInnerHtml": "off"
					}
				}
			}
		},
		{
			"includes": [
				"packages/ui/.storybook/**",
				"packages/components/.storybook/**",
				"packages/ui/vitest.config.ts",
				"packages/ui/src/**/*.stories.tsx",
				"**/*.stories.*"
			],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					},
					"correctness": {
						"useHookAtTopLevel": "off"
					},
					"suspicious": {
						"noShadowRestrictedNames": "off"
					}
				}
			}
		},
		{
			"includes": [
				"packages/ui/src/components/icons.tsx",
				"packages/ui/src/foundations/icon-stroke.stories.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/website/index.html"],
			"linter": {
				"rules": {
					"complexity": {
						"noArguments": "off",
						"noCommaOperator": "off",
						"useArrowFunction": "off"
					},
					"suspicious": {
						"noAssignInExpressions": "off"
					}
				}
			}
		},
		{
			"includes": ["**/prisma.config.ts"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		}
	]
}
