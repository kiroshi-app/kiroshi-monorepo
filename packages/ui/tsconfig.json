{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "./dist",
		"jsx": "react-jsx",
		"paths": {
			"@workspace/ui/*": ["./src/*"],
			"@workspace/storybook/*": ["./.storybook/*"]
		}
	},
	"include": [
		"src",
		".storybook/**/*.ts",
		".storybook/**/*.tsx",
		"vitest.config.ts"
	],
	"exclude": ["node_modules", "dist"]
}
