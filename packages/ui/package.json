{
	"name": "@workspace/ui",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kiroshi-app/kiroshi-monorepo.git"
	},
	"type": "module",
	"exports": {
		"./globals.css": "./src/styles/globals.css",
		"./styles/*": "./src/styles/*",
		"./lib/*": "./src/lib/*.ts",
		"./components/*": [
			"./src/components/*.tsx",
			"./src/components/*.ts",
			"./src/components/*/index.tsx"
		],
		"./hooks/*": "./src/hooks/*.ts"
	},
	"scripts": {
		"types": "tsc -b",
		"lint": "biome lint",
		"lint:fix": "biome check --assist-enabled=true --unsafe --write .",
		"storybook": "storybook dev --port 6006 --no-open",
		"build-storybook": "storybook build",
		"test": "vitest run",
		"test:storybook": "vitest run --project=storybook"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@keyline-icons/react": "^1.7.0",
		"@pierre/diffs": "1.5.2",
		"@shadcn/react": "^0.3.1",
		"@workspace/shared": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"i18next": "^26.4.3",
		"input-otp": "^1.5.0",
		"katex": "^0.19.0",
		"mermaid": "^12.1.0",
		"motion": "^14.1.0",
		"overlayscrollbars": "^2.15.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-i18next": "^17.0.16",
		"react-markdown": "^10.1.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"shiki": "^4.5.0",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "10.6.1",
		"@storybook/addon-docs": "10.6.1",
		"@storybook/addon-mcp": "10.6.1",
		"@storybook/addon-themes": "10.6.1",
		"@storybook/addon-vitest": "10.6.1",
		"@storybook/react-vite": "10.6.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/browser": "5.0.5",
		"@vitest/browser-playwright": "5.0.3",
		"happy-dom": "^20.11.6",
		"playwright": "1.64.0",
		"shadcn": "^4.21.4",
		"storybook": "10.6.1",
		"storybook-addon-pseudo-states": "10.6.1",
		"tailwindcss": "^4",
		"vite": "catalog:",
		"vitest": "5.0.3"
	}
